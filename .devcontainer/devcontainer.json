{
  "name": "Gauntlet",
  // Context is the repository root so the image can read dependencies.txt.
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "args": {
      "PYTHON_IMAGE": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm"
    }
  },

  // Bind mounts fail on a host where the source is absent, so create them.
  // /tmp/.X11-unix is already there on a host running X11; the mkdir is for one
  // that is not, where the mount then carries nothing and DISPLAY is empty.
  "initializeCommand": "mkdir -p ${localEnv:HOME}/.claude ${localEnv:HOME}/.codex ${localEnv:HOME}/.config/git /tmp/.X11-unix && touch ${localEnv:HOME}/.gitconfig",

  // Mounted onto dev's home, the account everything in the container runs as.
  //
  // .gitconfig and .config/git carry the host's identity, aliases and global
  // excludes, so commits made in here are attributed the same way. Both are
  // writable: `git config --global` inside the container is meant to reach the
  // same file the host reads.
  //
  // claude and codex are installed in the image; their directories carry the
  // host's credentials so neither has to be signed in again.
  "mounts": [
    "source=${localEnv:HOME}/.config/git,target=/home/dev/.config/git,type=bind",
    "source=${localEnv:HOME}/.gitconfig,target=/home/dev/.gitconfig,type=bind",
    "source=${localEnv:HOME}/.ssh,target=/home/dev/.ssh,type=bind",
    "source=${localEnv:HOME}/.claude,target=/home/dev/.claude,type=bind",
    "source=${localEnv:HOME}/.codex,target=/home/dev/.codex,type=bind",

    // The host's X11 socket, so `make app-dev` opens a window on the host's
    // display rather than needing Xvfb. DISPLAY below names which one.
    "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind",

    // The host's /dev, so a USB instrument on the bench is reachable from in
    // here. A directory bind rather than `--device` passthrough because the
    // two differ on a node that does not exist yet: `--device` names one file
    // and fails when it is absent, where the bind carries the host's devtmpfs
    // itself and a node created later shows up in it. Plugging an instrument
    // in, or replugging one that renumbered, needs no container restart.
    //
    // Being visible is not being usable: runArgs below permits three device
    // majors and Docker denies the rest, so the host's disks are listed here
    // and cannot be opened.
    "source=/dev,target=/dev,type=bind"
  ],

  // Device access for the instruments, granted by major number so a node that
  // appears after the container started is covered by the rule already in
  // place:
  //
  //   166  ttyACM*  USB CDC-ACM serial
  //   188  ttyUSB*  USB serial bridges, the PSU's CH340 among them
  //   189  bus/usb  raw USB, which the DATAQ DAQ is driven over
  //
  // Without these the nodes mounted above are visible and every open on one
  // fails with EPERM.
  "runArgs": [
    "--device-cgroup-rule=c 166:* rmw",
    "--device-cgroup-rule=c 188:* rmw",
    "--device-cgroup-rule=c 189:* rmw"
  ],

  // git-lfs because a mounted .gitconfig may declare the lfs filter with
  // required = true, which fails every checkout when the binary is absent.
  //
  // docker-outside-of-docker installs the client and mounts the host's daemon
  // socket, so `make docker-build` works in here and the image it produces is
  // the host's. The daemon stays the host's: a bind mount in `docker run` is
  // resolved against the host's filesystem, not this container's.
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/git-lfs:1": {}
  },

  // Everything in the container runs as dev, whose uid and gid track the
  // caller's, so files on the bind mount keep one owner on both sides.
  "remoteUser": "dev",
  "containerUser": "dev",
  "updateRemoteUserUID": true,

  "workspaceFolder": "/workspaces/gauntlet",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/gauntlet,type=bind,consistency=cached",

  // 7100 is the app; 7101 is reserved for the frontend dev server.
  //
  // forwardPorts tunnels through the editor and only reaches the machine the
  // editor runs on. appPort publishes the same ports on the Docker host, so a
  // browser on another machine can reach them. Both need the server bound to
  // every interface: `make run HOST=0.0.0.0`.
  "appPort": ["7100:7100", "7101:7101"],
  "forwardPorts": [7100, 7101],
  "portsAttributes": {
    "7100": { "label": "Gauntlet", "onAutoForward": "notify" },
    "7101": { "label": "Frontend dev server", "onAutoForward": "silent" }
  },

  // The host's path to this checkout. The daemon reached through the mounted
  // socket resolves a bind mount against the host, so a compose file run from
  // in here cannot name the source by its path inside the container.
  // DISPLAY is the host's, reached through the X11 socket mounted above. It is
  // empty on a host without X11, where the app needs `xvfb-run make app-dev`
  // instead and nothing is displayed.
  "containerEnv": {
    "DISPLAY": "${localEnv:DISPLAY}",
    "GAUNTLET_DEVCONTAINER": "true",
    "GAUNTLET_HOST_WORKSPACE": "${localWorkspaceFolder}"
  },

  "postCreateCommand": "make setup",

  "customizations": {
    "vscode": {
      "extensions": [
        "charliermarsh.ruff",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "redhat.vscode-yaml",
        "tamasfe.even-better-toml"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": [
          "packages/gauntlet/tests",
          "packages/gauntlet-sdk/tests"
        ],
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff"
        },
        // Every suite.yaml validates against the schema the running app serves.
        "yaml.schemas": {
          "http://127.0.0.1:7100/api/schemas/suite": "suites/*/suite.yaml"
        },
        "files.watcherExclude": {
          "**/.venv/**": true,
          "**/build/**": true,
          "**/output/**": true,
          "**/node_modules/**": true
        },
        "remote.autoForwardPorts": false
      }
    }
  }
}
