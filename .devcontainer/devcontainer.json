{
  "name": "Gauntlet",
  // Context is the repository root so the image can read dependencies.txt.
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "args": {
      "PYTHON_IMAGE": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm"
    }
  },

  // Bind mounts fail on a host where the source is absent, so create them.
  "initializeCommand": "mkdir -p ${localEnv:HOME}/.claude ${localEnv:HOME}/.codex ${localEnv:HOME}/.config/git && touch ${localEnv:HOME}/.gitconfig",

  // Mounted onto dev's home, the account everything in the container runs as.
  //
  // .gitconfig and .config/git carry the host's identity, aliases and global
  // excludes, so commits made in here are attributed the same way. Both are
  // writable: `git config --global` inside the container is meant to reach the
  // same file the host reads.
  //
  // claude and codex are installed in the image; their directories carry the
  // host's credentials so neither has to be signed in again.
  "mounts": [
    "source=${localEnv:HOME}/.config/git,target=/home/dev/.config/git,type=bind",
    "source=${localEnv:HOME}/.gitconfig,target=/home/dev/.gitconfig,type=bind",
    "source=${localEnv:HOME}/.ssh,target=/home/dev/.ssh,type=bind",
    "source=${localEnv:HOME}/.claude,target=/home/dev/.claude,type=bind",
    "source=${localEnv:HOME}/.codex,target=/home/dev/.codex,type=bind"
  ],

  // git-lfs because a mounted .gitconfig may declare the lfs filter with
  // required = true, which fails every checkout when the binary is absent.
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/git-lfs:1": {}
  },

  // Everything in the container runs as dev, whose uid and gid track the
  // caller's, so files on the bind mount keep one owner on both sides.
  "remoteUser": "dev",
  "containerUser": "dev",
  "updateRemoteUserUID": true,

  "workspaceFolder": "/workspaces/gauntlet",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/gauntlet,type=bind,consistency=cached",

  // 7100 is the app; 7101 is reserved for the frontend dev server.
  //
  // forwardPorts tunnels through the editor and only reaches the machine the
  // editor runs on. appPort publishes the same ports on the Docker host, so a
  // browser on another machine can reach them. Both need the server bound to
  // every interface: `make run HOST=0.0.0.0`.
  "appPort": ["7100:7100", "7101:7101"],
  "forwardPorts": [7100, 7101],
  "portsAttributes": {
    "7100": { "label": "Gauntlet", "onAutoForward": "notify" },
    "7101": { "label": "Frontend dev server", "onAutoForward": "silent" }
  },

  "containerEnv": {
    "GAUNTLET_DEVCONTAINER": "true"
  },

  "postCreateCommand": "make setup",

  "customizations": {
    "vscode": {
      "extensions": [
        "charliermarsh.ruff",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "redhat.vscode-yaml",
        "tamasfe.even-better-toml"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": [
          "packages/gauntlet/tests",
          "packages/gauntlet-sdk/tests"
        ],
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff"
        },
        // Every suite.yaml validates against the schema the running app serves.
        "yaml.schemas": {
          "http://127.0.0.1:7100/api/schemas/suite": "suites/*/suite.yaml"
        },
        "files.watcherExclude": {
          "**/.venv/**": true,
          "**/build/**": true,
          "**/output/**": true,
          "**/node_modules/**": true
        },
        "remote.autoForwardPorts": false
      }
    }
  }
}
